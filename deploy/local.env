# Where the local docker-compose stack listens. Local-development values only: they match the
# defaults in docker-compose.yml and protect nothing.
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_OPENSEARCH_URL=http://127.0.0.1:9200
RAG_NEO4J_URL=bolt://127.0.0.1:7687
RAG_NEO4J_USER=neo4j
RAG_NEO4J_PASSWORD=local-dev-only
RAG_POSTGRES_DSN=postgresql://rag:local-dev-only@127.0.0.1:5432/rag
RAG_MINIO_ENDPOINT=127.0.0.1:9000
RAG_MINIO_ACCESS_KEY=rag-local
RAG_MINIO_SECRET_KEY=local-dev-only
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_OTLP_ENDPOINT=http://127.0.0.1:4318
RAG_PHOENIX_URL=http://127.0.0.1:6006
RAG_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# DVC reads its remote credentials from the standard AWS variables.
AWS_ACCESS_KEY_ID=rag-local
AWS_SECRET_ACCESS_KEY=local-dev-only
